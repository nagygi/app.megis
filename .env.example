APP_NAME=mégis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Budapest

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Channels: app, auth, ai, mail, queue (docs/uzemeltetes.md · 4)
LOG_CHANNEL=stack
LOG_STACK=app
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# PostgreSQL (AWS RDS on shared environments). sqlite works locally until then.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=megis
DB_USERNAME=megis
DB_PASSWORD=
DB_SSLMODE=prefer

# Redis carries cache, session and queue on shared environments.
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@megis.hu"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private file store for recordings, transcripts and documents: local or s3
MATERIALS_DISK_DRIVER=local
MATERIALS_BUCKET=

# AI layer (16). Models are decided with the 12.7 PoC; prices go to config/ai.php.
# Claude stays in the EU through Amazon Bedrock (AWS_BEDROCK_REGION).
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-5-5
AI_SMALL_MODEL=claude-haiku-5-5
AI_TRANSCRIPTION_PROVIDER=openai
AI_TRANSCRIPTION_MODEL=
# Képességmérés (NM-12): after the value measurement every diagnosis material is
# read for capability traces too. false switches it off; _PLAIN: outside a main diagnosis.
CAPABILITY_MEASUREMENT=true
CAPABILITY_MEASUREMENT_PLAIN=true
MIRROR_DEEPENING=true
# Unit prices: megis:prices:sync reads this list daily (default: LiteLLM on GitHub).
# AI_PRICE_SOURCE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_URL=https://eu.api.openai.com/v1
GEMINI_API_KEY=
AWS_BEDROCK_REGION=eu-central-1

# Értéktükör and materials (06). "fake" gives a sample transcript for local work.
MEGIS_TRANSCRIBER=ai
FFPROBE_PATH=ffprobe
MEGIS_INDIVIDUAL_PRODUCT="Snapshot · Belső"
# Seconds a recalculation of a main diagnosis waits, so a burst of events counts once.
DIAGNOSIS_RECALCULATION_DELAY=20

# PDF of the report and the Útravaló (28 · 28.3): gotenberg (a Gotenberg container, Chromium, next to the app)
# or weasyprint (the WeasyPrint binary, for hosts without Docker; Geologica installed as a system font).
LARAVEL_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://localhost:3000
# weasyprint only: the binary, e.g. /usr/local/bin/weasyprint; never empty (default: weasyprint on the PATH).
LARAVEL_PDF_WEASYPRINT_BINARY=weasyprint
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

# Calendar connection (09), read-only. Without keys only the iCal link and the ICS file are offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Cloudflare Turnstile. Locally the test keys 1x00000000000000000000AA /
# 1x0000000000000000000000000000000AA always pass.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# mégis
MEGIS_SUPPORT_EMAIL=
MEGIS_BOOKING_URL=
# Receives the Értéktükör curiosity questions ("Elküldöm" on ET5)
MEGIS_INTEREST_EMAIL=ng@exot.hu
# Comma separated; receives error alerts (docs/uzemeltetes.md · 5)
MEGIS_ALERT_RECIPIENTS=
# Unlocks the detailed GET /health response
MEGIS_HEALTH_TOKEN=
MEGIS_HEALTH_MIN_FREE_DISK_MB=1024
# Outside production: comma separated addresses or "@domain" entries that may receive mail; empty sends to everyone
MEGIS_MAIL_ALLOWLIST=
# Staging protection: basic auth and/or comma separated IPs or CIDR ranges
MEGIS_STAGING_USER=
MEGIS_STAGING_PASSWORD=
MEGIS_STAGING_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"
